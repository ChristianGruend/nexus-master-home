# NEXUS Linux / Termux-adjacent 8GB RAM profile (Phase 12)
# Usage: set -a && source ./env.linux.8gb.example && set +a && ./start_nexus.sh
# No secrets. No Bridge token. never_pull is enforced in code/ai_models.json.

export NEXUS_HOST="${NEXUS_HOST:-0.0.0.0}"
export NEXUS_PORT="${NEXUS_PORT:-8299}"
export NEXUS_SSL_PORT="${NEXUS_SSL_PORT:-8443}"

# VRAM / RAM: unload after each request (critical on 8GB hosts)
export NEXUS_KEEP_ALIVE=0

# Prefer installed chat model when present; never auto-pull
export NEXUS_MODEL="${NEXUS_MODEL:-qwen2.5:7b}"
# Vision optional / heavy on 8GB — leave default; only used if model installed
# export NEXUS_VISION_MODEL=llava:latest

# Ollama optional: local default, or point at LAN host from Termux
export NEXUS_OLLAMA_URL="${NEXUS_OLLAMA_URL:-http://127.0.0.1:11434}"

# Bridge process level (HTTP bridge); privileged PS actions still Windows-only
export NEXUS_BRIDGE_PROCESS_LEVEL="${NEXUS_BRIDGE_PROCESS_LEVEL:-SAFE_WRITE}"

# Hint for ops scripts / docs (informational)
export NEXUS_RAM_PROFILE=8GB
